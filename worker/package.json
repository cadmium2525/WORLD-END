{
  "name": "world-end-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "cd .. && npx tsx tools/stages-version.ts write",
    "dev": "wrangler dev",
    "predeploy": "cd .. && npx tsx tools/stages-version.ts write",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute world-end --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute world-end --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute world-end --local --file=./migrate-200.sql",
    "db:migrate:remote": "wrangler d1 execute world-end --remote --file=./migrate-200.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "typescript": "5.9.3",
    "wrangler": "4.151.2"
  }
}
